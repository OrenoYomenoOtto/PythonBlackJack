//Alt + d でプレビュー
@startuml

enum Suit{
    CLUB
    HEART
    SPADE
    DIAMOND
}

class Rank{
    - instance: dict{static} 
    - name: str
    - value: int
    --
    + __new__(cls, name: str, value: int)
    + __init__(self, name: str, value: int)
}

class Card{
    - suit :Suit
    - rank :Rank
    --
    + __init__(suit: Suit, rank: Rank)
    + __str__()
}

Card *-- Suit
Card *-- Rank

class Deck{
    + RANKS: Tuple[Tuple[str, int]] {static}
    - cards :
    --
    + __init__()
    + void shuffle()
    + void draw()
}

Deck *-- Card

interface Rule{
    --
    + void Hit()
    + void Stand()
}

class PlayerRule{

}

class DealerRule{

}

Rule <|.. PlayerRule
Rule <|.. DealerRule

class Hand{
    - cards: List<Card>
    --
    + void add_Card()
}

Hand *-- Card

class Player{
    - rule: Rule
}

class Dealer{
    - rule: Rule
}

Player *-- Hand
Dealer *-- Hand
Rule o.. Player
Rule o.. Dealer


@enduml